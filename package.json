{
  "name": "eklund.com.br",
  "version": "1.0.0",
  "private": true,
  "description": "Personal homepage. The site lives in source/, its automated tests in tests/.",
  "keywords": [
    "accessibility",
    "content-security-policy",
    "i18n",
    "personal-website",
    "portfolio",
    "vanilla-javascript",
    "wcag",
    "web-workers",
    "webgl"
  ],
  "homepage": "https://eklund.com.br",
  "bugs": {
    "url": "https://github.com/GustavoEklund/eklund.com.br/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gustavo Eklund",
    "url": "https://eklund.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoEklund/eklund.com.br.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "node tools/serve.mjs --port 8734",
    "build": "vp build --config vite.build.config.js && vp build --config vite.build.config.js --mode version",
    "preview": "vp run build && node tools/serve.mjs --port 8737 --root dist",
    "measure:build": "node tools/measure-build.mjs",
    "screenshots": "node tools/readme-screenshots.mjs",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:css": "stylelint \"source/**/*.css\"",
    "i18n": "node tools/i18n-check.mjs",
    "proofread": "cspell lint --no-progress --no-summary --cache --cache-location .cspellcache --dot \"**/*\"",
    "commit-gate": "node tools/commit-gate.mjs",
    "changelog": "node tools/changelog.mjs",
    "adblock": "node tools/adblock-check.mjs",
    "validate:html": "node tools/validate-html.mjs",
    "a11y": "playwright test tests/e2e/accessibility.e2e.test.js tests/e2e/aria-patterns.e2e.test.js tests/e2e/wcag22.e2e.test.js",
    "contrast": "node tools/contrast-audit.mjs",
    "measure": "node tools/measure-sections.mjs --write",
    "test": "vp check && node tools/i18n-check.mjs && pnpm run proofread && vp test run && cucumber-js && playwright test",
    "verify": "vp check && node tools/i18n-check.mjs && pnpm run proofread && vp test run && cucumber-js",
    "test:vitest": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:property": "vp test run --project property",
    "test:component": "vp test run --project component",
    "test:integration": "vp test run --project integration --project integration-browser",
    "test:contract": "vp test run --project contract",
    "test:standards": "vp test run --project contract && playwright test tests/e2e/fonts.e2e.test.js tests/e2e/security.e2e.test.js tests/e2e/i18n-standards.e2e.test.js",
    "test:architecture": "vp test run --project architecture",
    "test:build": "vp test run --project build",
    "test:e2e:dist": "SITE_ROOT=dist playwright test",
    "test:bdd": "cucumber-js",
    "test:e2e": "playwright test",
    "test:mutation": "node tools/mutation.mjs",
    "coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/format": "21.2.3",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@cspell/dict-pt-br": "^2.4.4",
    "@cucumber/cucumber": "^13.3.0",
    "@ghostery/adblocker": "^2.20.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "^8.20.0",
    "csp_evaluator": "^1.1.8",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^18.6.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "html-minifier-terser": "^7.2.0",
    "jsonld": "^9.0.0",
    "playwright": "^1.64.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite-plus": "^1.3.0",
    "vitest": "5.0.5",
    "vnu-jar": "^26.10.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
