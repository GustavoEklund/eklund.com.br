{
  "ci": {
    "collect": {
      "startServerCommand": "node tools/production-server.mjs --root dist --port 8738",
      "startServerReadyPattern": "ready",
      "url": ["https://127.0.0.1:8738/", "https://127.0.0.1:8738/en/"],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --use-angle=swiftshader --enable-unsafe-swiftshader --ignore-gpu-blocklist --ignore-certificate-errors --accept-lang=pt-BR"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02,
            "aggregationMethod": "median-run"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 360000,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 70000,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 200000,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:total:count": [
          "error",
          {
            "maxNumericValue": 12,
            "aggregationMethod": "median-run"
          }
        ],
        "errors-in-console": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "bf-cache": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ]
      }
    }
  }
}
