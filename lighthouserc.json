{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --use-angle=swiftshader --enable-unsafe-swiftshader --ignore-gpu-blocklist"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 360000
          }
        ],
        "errors-in-console": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
