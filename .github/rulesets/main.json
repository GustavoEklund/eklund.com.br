{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Format, lint, i18n audit and spelling" },
          {
            "context": "Unit, property, component, integration, contract and architecture tests, with coverage"
          },
          { "context": "Behavior-driven scenarios" },
          { "context": "End-to-end, accessibility and layout stability" },
          { "context": "W3C validation, WCAG contrast sweep and CSS lint" },
          { "context": "Production build, its checks and its end-to-end run" },
          { "context": "Lighthouse on the production build" },
          { "context": "Pull request title" },
          { "context": "Commit messages" },
          { "context": "Changelog entry" },
          { "context": "Lint the workflows (actionlint and zizmor)" },
          { "context": "Look for secrets in the history" },
          { "context": "Known vulnerabilities in the dependencies" },
          { "context": "Analyze (actions)" },
          { "context": "Analyze (javascript-typescript)" }
        ]
      }
    }
  ]
}
