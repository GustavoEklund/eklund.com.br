# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# A trailing double space is a line break in Markdown, and nothing else here relies on it.
trim_trailing_whitespace = true

[*.py]
indent_size = 4
